// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Goal {
  WEIGHT_LOSS
  MAINTENANCE
  WEIGHT_GAIN
  MUSCLE_GAIN
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum UsageAction {
  PLAN_GENERATION
  RELEVANT_REGENERATION
}

enum UsageStatus {
  PENDING
  CONSUMED
  RELEASED
  FAILED
}

enum UsageEntitlement {
  FREE
  SUBSCRIPTION
}

enum SubscriptionProvider {
  CAKTO
}

enum SubscriptionPlan {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum CheckoutAttemptStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  email            String            @unique
  passwordHash     String
  status           UserStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  profile          Profile?
  usageControl     UsageControl?
  usageEvents      UsageEvent[]
  mealPlans        MealPlan[]
  progressEntries  ProgressEntry[]
  subscriptions    Subscription[]
  checkoutAttempts CheckoutAttempt[]
}

model ProgressEntry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  weightKg   Decimal  @db.Decimal(6, 2)
  recordedAt DateTime @db.Date
  note       String?  @db.VarChar(1000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
}

model Profile {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @unique @db.Uuid
  birthDate        DateTime      @db.Date
  sex              Sex
  heightCm         Decimal       @db.Decimal(5, 2)
  weightKg         Decimal       @db.Decimal(6, 2)
  goal             Goal
  activityLevel    ActivityLevel
  mealsPerDay      Int
  weeklyFoodBudget Decimal       @db.Decimal(10, 2)
  foodPreferences  String[]      @default([])
  likedFoods       String[]      @default([])
  dislikedFoods    String[]      @default([])
  foodRestrictions String[]      @default([])
  foodAllergies    String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageControl {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @db.Uuid
  freeUsesLimit    Int          @default(3)
  freeUsesConsumed Int          @default(0)
  freeUsesReserved Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents      UsageEvent[]

  @@unique([id, userId])
}

model UsageEvent {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  usageControlId String           @db.Uuid
  action         UsageAction
  status         UsageStatus      @default(PENDING)
  idempotencyKey String
  entitlement    UsageEntitlement @default(FREE)
  subscriptionId String?          @db.Uuid
  createdAt      DateTime         @default(now())
  finalizedAt    DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageControl   UsageControl     @relation(fields: [usageControlId, userId], references: [id, userId], onDelete: Cascade)
  mealPlan       MealPlan?
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@index([usageControlId, status, createdAt])
  @@index([subscriptionId, status, createdAt])
}

model Subscription {
  id                     String               @id @default(uuid()) @db.Uuid
  userId                 String               @db.Uuid
  provider               SubscriptionProvider @default(CAKTO)
  plan                   SubscriptionPlan
  status                 SubscriptionStatus   @default(PENDING)
  providerSubscriptionId String?              @unique
  providerCustomerId     String?
  providerProductId      String?
  providerOfferId        String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  lastEventOccurredAt    DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents            UsageEvent[]

  @@index([userId, status, currentPeriodEnd])
}

model CheckoutAttempt {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  token       String                @unique
  plan        SubscriptionPlan
  status      CheckoutAttemptStatus @default(PENDING)
  checkoutUrl String
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model PaymentWebhookEvent {
  id              String               @id @default(uuid()) @db.Uuid
  provider        SubscriptionProvider
  providerEventId String
  eventType       String
  occurredAt      DateTime?
  receivedAt      DateTime             @default(now())
  processedAt     DateTime?
  payloadHash     String?
  processingError String?

  @@unique([provider, providerEventId])
}

model MealPlan {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @db.Uuid
  usageEventId     String     @unique @db.Uuid
  title            String
  content          Json
  profileSnapshot  Json
  model            String
  promptVersion    String
  schemaVersion    Int        @default(1)
  openaiResponseId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvent       UsageEvent @relation(fields: [usageEventId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([usageEventId, userId])
  @@index([userId, createdAt])
}
