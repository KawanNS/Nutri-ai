// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum UserRole {
  USER
  ADMIN
}

enum AiRouteAuditAction {
  CREATE
  UPDATE
}

enum AiRouteOrigin {
  DEFAULT
  PERSISTED
}

enum Goal {
  WEIGHT_LOSS
  MAINTENANCE
  WEIGHT_GAIN
  MUSCLE_GAIN
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum UsageAction {
  PLAN_GENERATION
  RELEVANT_REGENERATION
}

enum UsageStatus {
  PENDING
  CONSUMED
  RELEASED
  FAILED
}

enum UsageEntitlement {
  FREE
  SUBSCRIPTION
}

enum SubscriptionProvider {
  CAKTO
}

enum SubscriptionPlan {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum CheckoutAttemptStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum FoodEstimateConfidence {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  email             String             @unique
  passwordHash      String
  status            UserStatus         @default(ACTIVE)
  role              UserRole           @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  profile           Profile?
  usageControl      UsageControl?
  usageEvents       UsageEvent[]
  mealPlans         MealPlan[]
  progressEntries   ProgressEntry[]
  subscriptions     Subscription[]
  checkoutAttempts  CheckoutAttempt[]
  aiRoutesUpdated   AiRouteConfig[]    @relation("AiRouteUpdatedBy")
  aiRouteChanges    AiRouteAuditLog[]  @relation("AiRouteChangedBy")
  aiPricingCreated  AiModelPricing[]   @relation("AiPricingCreatedBy")
  chatConversations ChatConversation[]
  foodLogs          FoodLog[]
}

model ProgressEntry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  weightKg   Decimal  @db.Decimal(6, 2)
  recordedAt DateTime @db.Date
  note       String?  @db.VarChar(1000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
}

model Profile {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @unique @db.Uuid
  birthDate        DateTime      @db.Date
  sex              Sex
  heightCm         Decimal       @db.Decimal(5, 2)
  weightKg         Decimal       @db.Decimal(6, 2)
  goal             Goal
  activityLevel    ActivityLevel
  mealsPerDay      Int
  weeklyFoodBudget Decimal       @db.Decimal(10, 2)
  foodPreferences  String[]      @default([])
  likedFoods       String[]      @default([])
  dislikedFoods    String[]      @default([])
  foodRestrictions String[]      @default([])
  foodAllergies    String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageControl {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @db.Uuid
  freeUsesLimit    Int          @default(3)
  freeUsesConsumed Int          @default(0)
  freeUsesReserved Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents      UsageEvent[]

  @@unique([id, userId])
}

model UsageEvent {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  usageControlId String           @db.Uuid
  action         UsageAction
  status         UsageStatus      @default(PENDING)
  idempotencyKey String
  entitlement    UsageEntitlement @default(FREE)
  subscriptionId String?          @db.Uuid
  createdAt      DateTime         @default(now())
  finalizedAt    DateTime?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageControl   UsageControl     @relation(fields: [usageControlId, userId], references: [id, userId], onDelete: Cascade)
  mealPlan       MealPlan?
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@index([usageControlId, status, createdAt])
  @@index([subscriptionId, status, createdAt])
}

model Subscription {
  id                     String               @id @default(uuid()) @db.Uuid
  userId                 String               @db.Uuid
  provider               SubscriptionProvider @default(CAKTO)
  plan                   SubscriptionPlan
  status                 SubscriptionStatus   @default(PENDING)
  providerSubscriptionId String?              @unique
  providerCustomerId     String?
  providerProductId      String?
  providerOfferId        String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  lastEventOccurredAt    DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents            UsageEvent[]

  @@index([userId, status, currentPeriodEnd])
}

model CheckoutAttempt {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @db.Uuid
  token       String                @unique
  plan        SubscriptionPlan
  status      CheckoutAttemptStatus @default(PENDING)
  checkoutUrl String
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model PaymentWebhookEvent {
  id              String               @id @default(uuid()) @db.Uuid
  provider        SubscriptionProvider
  providerEventId String
  eventType       String
  occurredAt      DateTime?
  receivedAt      DateTime             @default(now())
  processedAt     DateTime?
  payloadHash     String?
  processingError String?

  @@unique([provider, providerEventId])
}

model MealPlan {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @db.Uuid
  usageEventId     String     @unique @db.Uuid
  title            String
  content          Json
  profileSnapshot  Json
  model            String
  promptVersion    String
  schemaVersion    Int        @default(1)
  openaiResponseId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvent       UsageEvent @relation(fields: [usageEventId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([usageEventId, userId])
  @@index([userId, createdAt])
}

model ChatConversation {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt(sort: Desc), id(sort: Desc)])
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @db.Uuid
  role           ChatMessageRole
  content        String           @db.Text
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id])
}

model FoodLog {
  id                         String        @id @default(uuid()) @db.Uuid
  userId                     String        @db.Uuid
  consumedAt                 DateTime      @default(now())
  estimatedCaloriesKcal      Decimal?      @db.Decimal(8, 2)
  estimatedProteinGrams      Decimal?      @db.Decimal(8, 2)
  estimatedCarbohydrateGrams Decimal?      @db.Decimal(8, 2)
  estimatedFatGrams          Decimal?      @db.Decimal(8, 2)
  notes                      String?       @db.VarChar(1000)
  uncertaintyNotes           String[]      @default([])
  confirmedAt                DateTime      @default(now())
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  user                       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                      FoodLogItem[]

  @@index([userId, consumedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
}

model FoodLogItem {
  id                         String                 @id @default(uuid()) @db.Uuid
  foodLogId                  String                 @db.Uuid
  position                   Int
  name                       String                 @db.VarChar(120)
  portionDescription         String                 @db.VarChar(240)
  estimatedCaloriesKcal      Decimal?               @db.Decimal(8, 2)
  estimatedProteinGrams      Decimal?               @db.Decimal(8, 2)
  estimatedCarbohydrateGrams Decimal?               @db.Decimal(8, 2)
  estimatedFatGrams          Decimal?               @db.Decimal(8, 2)
  confidence                 FoodEstimateConfidence @default(UNKNOWN)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  foodLog                    FoodLog                @relation(fields: [foodLogId], references: [id], onDelete: Cascade)

  @@unique([foodLogId, position])
  @@index([foodLogId])
}

model AiRouteConfig {
  id              String            @id @default(uuid()) @db.Uuid
  task            String            @unique @db.VarChar(64)
  provider        String            @db.VarChar(32)
  model           String            @db.VarChar(120)
  enabled         Boolean           @default(true)
  version         Int               @default(1)
  updatedByUserId String            @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  updatedBy       User              @relation("AiRouteUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  auditLogs       AiRouteAuditLog[]

  @@index([updatedByUserId, updatedAt(sort: Desc)])
}

model AiRouteAuditLog {
  id               String             @id @default(uuid()) @db.Uuid
  routeConfigId    String             @db.Uuid
  task             String             @db.VarChar(64)
  action           AiRouteAuditAction
  previousOrigin   AiRouteOrigin
  previousProvider String             @db.VarChar(32)
  previousModel    String             @db.VarChar(120)
  previousEnabled  Boolean
  previousVersion  Int?
  newProvider      String             @db.VarChar(32)
  newModel         String             @db.VarChar(120)
  newEnabled       Boolean
  newVersion       Int
  changedByUserId  String             @db.Uuid
  createdAt        DateTime           @default(now())
  routeConfig      AiRouteConfig      @relation(fields: [routeConfigId], references: [id], onDelete: Restrict)
  changedBy        User               @relation("AiRouteChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@unique([routeConfigId, newVersion])
  @@index([task, createdAt(sort: Desc), id(sort: Desc)])
  @@index([changedByUserId, createdAt(sort: Desc)])
}

model AiModelPricing {
  id                           String         @id @default(uuid()) @db.Uuid
  provider                     String         @db.VarChar(32)
  model                        String         @db.VarChar(120)
  version                      Int
  validFrom                    DateTime
  validUntil                   DateTime?
  currency                     String         @db.Char(3)
  inputMicrosPerMillionTokens  BigInt         @db.BigInt
  outputMicrosPerMillionTokens BigInt         @db.BigInt
  createdByUserId              String         @db.Uuid
  createdAt                    DateTime       @default(now())
  createdBy                    User           @relation("AiPricingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  usageEvents                  AiUsageEvent[]

  @@unique([provider, model, version])
  @@index([provider, model, validFrom(sort: Desc)])
}

model AiUsageEvent {
  id                  String          @id @default(uuid()) @db.Uuid
  task                String?         @db.VarChar(64)
  provider            String?         @db.VarChar(32)
  model               String?         @db.VarChar(120)
  startedAt           DateTime
  durationMs          Int
  success             Boolean
  errorCategory       String?         @db.VarChar(64)
  inputTokens         Int?
  outputTokens        Int?
  totalTokens         Int?
  cachedInputTokens   Int?
  reasoningTokens     Int?
  estimatedCostMicros BigInt?         @db.BigInt
  estimatedCurrency   String?         @db.Char(3)
  pricingVersion      Int?
  createdAt           DateTime        @default(now())
  pricing             AiModelPricing? @relation(fields: [provider, model, pricingVersion], references: [provider, model, version], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([task, createdAt(sort: Desc)])
  @@index([provider, createdAt(sort: Desc)])
  @@index([model, createdAt(sort: Desc)])
}
